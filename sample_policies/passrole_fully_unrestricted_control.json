{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowLaunchingInstances",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "*"
    },
    {
      "Sid": "FullyUnrestrictedPassRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "*"
    }
  ]
}
