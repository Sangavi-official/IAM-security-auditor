{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowLaunchingInstances",
      "Effect": "Allow",
      "Action": [
        "ec2:RunInstances",
        "ec2:DescribeInstances"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowPassingRoleToInstances",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::123456789012:role/*"
    }
  ]
}
